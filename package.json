{
  "name": "monorepo",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.23.2",
    "npm": "use-pnpm",
    "yarn": "use-pnpm",
    "pnpm": "^10.34.5"
  },
  "scripts": {
    "dev:nest": "turbo run dev --filter=nestjs",
    "chat": "pnpm --filter ai-agent run chat",
    "agent": "pnpm --filter ai-agent run agent",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^16.5.0",
    "prettier": "^3.8.1",
    "turbo": "latest",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vue-eslint-parser": "^9.4.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "19",
        "react-dom": "19"
      }
    },
    "packageExtensions": {
      "antd-mobile-icons": {
        "peerDependencies": {
          "react": "*"
        }
      },
      "alova": {
        "peerDependencies": {
          "react": "*",
          "react-dom": "*",
          "vue": "*"
        },
        "peerDependenciesMeta": {
          "react": {
            "optional": true
          },
          "react-dom": {
            "optional": true
          },
          "vue": {
            "optional": true
          }
        }
      }
    }
  }
}
