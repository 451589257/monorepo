{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 包含浏览器 WebCrypto/atob/btoa/TextEncoder 类型，供 encryptPassword 使用
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "allowImportingTsExtensions": false
  },
  "include": ["src"]
}
