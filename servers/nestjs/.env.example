# 复制为 .env.development / .env.production 后按需修改
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL="file:./dev.db"

# JWT 配置
# access token 用,短期(默认 15m)
JWT_SECRET="please-change-me-in-production"
JWT_EXPIRES_IN="15m"
# refresh token 用,长期(默认 7d),必须与 JWT_SECRET 不同
JWT_REFRESH_SECRET="please-change-me-in-production-refresh"
JWT_REFRESH_EXPIRES_IN="7d"
