# 复制为 .env.development / .env.production 后按需修改
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

DATABASE_URL="file:./dev.db"

# JWT 配置
# access token 用,短期(默认 15m)
JWT_SECRET="please-change-me-in-production"
JWT_EXPIRES_IN="15m"
# refresh token 用,长期(默认 7d),必须与 JWT_SECRET 不同
JWT_REFRESH_SECRET="please-change-me-in-production-refresh"
JWT_REFRESH_EXPIRES_IN="7d"

# 密码哈希(argon2id)参数,留空使用 OWASP 推荐默认值
# 内存开销(KiB),默认 19456(19MiB)
ARGON2_MEMORY_COST=19456
# 迭代次数,默认 2
ARGON2_TIME_COST=2
# 并行度,默认 1
ARGON2_PARALLELISM=1

# 认证接口限流(防暴力破解),按客户端 IP 统计
# 时间窗(秒)
AUTH_THROTTLE_TTL=60
# 窗口内最大请求数
AUTH_THROTTLE_LIMIT=5

# CORS 允许的来源,逗号分隔(如 http://localhost:5173,http://localhost:3000)
# 留空表示放行所有来源(仅建议开发环境)
CORS_ORIGIN=
