generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TodoStatus {
  PENDING
  ACTIVE
  DONE
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  passwordHash  String
  nickname      String?
  createTime    DateTime       @default(now())
  updateTime    DateTime       @updatedAt
  refreshTokens RefreshToken[]
  todos         Todo[]
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  // 存 sha256 哈希,不落明文
  tokenHash  String    @unique
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createTime DateTime  @default(now())

  @@index([userId])
}

model Todo {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  status      TodoStatus @default(PENDING)
  // 归属用户;存量数据无主,设为可空兼容旧记录,新建时强制写入
  userId      Int?
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createTime  DateTime   @default(now())
  updateTime  DateTime   @updatedAt

  @@index([userId])
}
