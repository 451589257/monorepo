generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TodoStatus {
  PENDING
  ACTIVE
  DONE
}

model Todo {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  status      TodoStatus @default(PENDING)
  createTime  DateTime   @default(now())
  updateTime  DateTime   @updatedAt
}
